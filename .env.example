# Required for live provider refresh. Keep secrets in Render Environment settings.
API_FOOTBALL_KEY=replace_with_your_api_football_key
# Optional secondary odds source
BZZOIRO_KEY=
# Optional settings
API_BASE=https://v3.football.api-sports.io
TZ_NAME=Africa/Lagos
ODDS_BOOKMAKER=8
MAX_CALLS=22
# Automatic refresh interval; set 0 to disable. Six hours uses up to ~88 API-Football calls/day at MAX_CALLS=22.
AUTO_REFRESH_HOURS=6
PRIORITY_LEAGUES=39,140,135,78,61,2,3,848,88,94,45,40,179
# Required to protect POST /api/refresh
REFRESH_TOKEN=use_a_long_random_secret_here
# Comma-separated allowed frontend origins; * is convenient for initial testing only
CORS_ORIGINS=*
PORT=10000
