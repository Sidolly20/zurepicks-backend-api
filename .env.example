# Set these in Render > Environment. Never commit real keys.
BZZOIRO_KEY=
# Telegram posting (the backend posts at 07:30, 07:45, 23:15 and Monday 08:00, Lagos time)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@zurepicks
# Optional: lets the backend start the site's "Update match data" run every 10 minutes (GitHub's own timer is unreliable).
# A fine-grained token for the zurepick-site repo with Actions: Read and write.
GITHUB_TOKEN=
GITHUB_REPO=Sidolly20/zurepick-site
# Optional (defaults shown)
# SITE_URL=https://sidolly20.github.io/zurepick-site
# SITE_DATA_BASE=https://sidolly20.github.io/zurepick-site/data
# TZ_NAME=Africa/Lagos
